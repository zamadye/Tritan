# ===========================================================================
# HERMES AIRDROP AGENT — environment variables
# ===========================================================================
# Copy to .env and fill in. This file installs to ~/.hermes/.env.
#
# RULE: secrets live HERE. Everything else lives in config/hermes/config.yaml.
#       Hermes' `hermes config set` enforces the same split.
#
# Placeholder values (sk-xxx, xxx, changeme, <...>) are treated as UNSET by
# `haa doctor`. Don't leave them in and expect the agent to start.
# ===========================================================================

# ---------------------------------------------------------------------------
# MODEL PROVIDER — set exactly one. Hermes auto-detects from what is present.
# ---------------------------------------------------------------------------

# Anthropic (direct API) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenRouter (one key, many models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Nous Portal (API key; or use `hermes auth add nous` for OAuth) —
NOUS_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, llama.cpp).
# Set model.provider: custom in config.yaml when using this.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# PER-WORKER MODELS (optional)
# ---------------------------------------------------------------------------
# Each profile pins its own model so a cheap model runs the daily check-in and
# a strong one runs the analysis. Unset values fall back to Hermes' default.
# Format is always "<provider>/<model>".
HAA_ANALYZER_MODEL=anthropic/claude-sonnet-4.5
HAA_DAILY_MODEL=anthropic/claude-haiku-4.5
HAA_QUESTS_MODEL=anthropic/claude-sonnet-4.5
HAA_DISCORD_MODEL=anthropic/claude-sonnet-4.5
HAA_MONITOR_MODEL=anthropic/claude-sonnet-4.5
HAA_CRON_MODEL=anthropic/claude-haiku-4.5

# ---------------------------------------------------------------------------
# BROWSER — Camofox (anti-detection Firefox/Camoufox server)
# ---------------------------------------------------------------------------
# Airdrop work is ~100% GUI: connect wallet, click claim, approve, sign, read a
# quest board. There is no CLI for any of it, so the browser is the product.
#
# Hermes reads CAMOFOX_URL from the environment. There is no config.yaml key
# for it; putting one there silently does nothing.
CAMOFOX_URL=http://localhost:9377

# The GUI. Camofox runs on an Xvfb display at 1x1 resolution unless the VNC
# plugin is on, so without this the browser is not merely headless — it is
# unwatchable, and nobody can take over for a CAPTCHA or MFA prompt.
# `docker compose up -d` enables it by default (ENABLE_VNC=1).
NOVNC_URL=http://localhost:6080

# STRONGLY RECOMMENDED. The noVNC port drives a browser that is logged into
# your accounts; leaving it open to anyone who can reach the host is how those
# accounts get taken.
VNC_PASSWORD=

# Optional host port overrides (must match docker-compose.yml).
CAMOFOX_PORT=9377
NOVNC_PORT=6080
VNC_PORT=5901

# Set these only if another application owns the visible Camofox browser and
# Hermes should operate inside that same session. Leave blank to let each
# worker use its own persistent profile (browser.camofox.user_id in
# config/hermes/profiles/*/config.yaml).
CAMOFOX_USER_ID=
CAMOFOX_SESSION_KEY=
CAMOFOX_ADOPT_EXISTING_TAB=false

# ---------------------------------------------------------------------------
# WHERE THINGS LIVE (used by config.yaml via ${...})
# ---------------------------------------------------------------------------
# install.sh sets these for you. Absolute paths only.
HAA_PROJECT_DIR=
HAA_DATA_DIR=

# ---------------------------------------------------------------------------
# ALERTING — Telegram (optional but recommended)
# ---------------------------------------------------------------------------
# Create a bot with @BotFather, then get your chat id from @userinfobot.
# Without these, halts are logged to data/logs/ but nobody is paged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# SPEND GUARDRAILS
# ---------------------------------------------------------------------------
# Per-action ceiling in USD. `haa plan` and the guardrails refuse anything
# above this without an explicit decision from you.
HAA_MAX_SPEND_USD=5.00

# ---------------------------------------------------------------------------
# WALLET ADDRESSES — monitoring only
# ---------------------------------------------------------------------------
# ADDRESSES ONLY. Never put a private key, seed phrase, or keystore here.
# `haa doctor` refuses to start if it finds key material in this file, and the
# evidence ledger refuses to log it. Keys belong in a hardware wallet.
#
# Prefer `haa wallets add --address 0x... --tier farming` — it validates the
# format, detects the chain, and writes data/wallets.json with mode 0600.
WALLET_ADDRESS_MAIN=
WALLET_ADDRESS_FARMING1=
WALLET_ADDRESS_FARMING2=

# ---------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# ---------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_DATABASE_ID=
