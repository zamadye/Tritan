# ===========================================================================
# HERMES AIRDROP AGENT — environment variables
# ===========================================================================
# Copy to .env and fill in. This file installs to ~/.hermes/.env.
#
# RULE: secrets live HERE. Everything else lives in config/hermes/config.yaml.
#       Hermes' `hermes config set` enforces the same split.
#
# Placeholder values (sk-xxx, xxx, changeme, <...>) are treated as UNSET by
# `haa doctor`. Don't leave them in and expect the agent to start.
# ===========================================================================

# ---------------------------------------------------------------------------
# MODEL PROVIDER — set exactly one. Hermes auto-detects from what is present.
# ---------------------------------------------------------------------------

# Anthropic (direct API) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenRouter (one key, many models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Nous Portal (API key; or use `hermes auth add nous` for OAuth) —
NOUS_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, llama.cpp).
# Set model.provider: custom in config.yaml when using this.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# MODEL SELECTION — read by config/hermes/**/config.yaml via ${...}
# ---------------------------------------------------------------------------
# Switching provider is a one-line edit here, not a hunt through eight files.
HAA_MODEL_PROVIDER=custom
HAA_MODEL_DEFAULT=
HAA_CONTEXT_LENGTH=128000

# Which model name to use. For provider=custom this is the gateway's bare model
# name; find yours with:
#   curl "$CUSTOM_BASE_URL/models" -H "Authorization: Bearer $CUSTOM_API_KEY"
# For a direct provider Hermes wants "<provider>/<model>", e.g.
# anthropic/claude-sonnet-4.5
#
# Example (agentrouter.org — an OpenAI-compatible community gateway):
#   HAA_MODEL_PROVIDER=custom
#   CUSTOM_BASE_URL=https://agentrouter.org/v1
#   CUSTOM_API_KEY=sk-...
#   HAA_MODEL_DEFAULT=<a name from /v1/models>
#
# NOTE if you use agentrouter: their Terms of Use prohibit "batch operations
# without genuine intent", "prolonged uninterrupted automated polling", and
# usage "unrelated to programming development". A 24/7 farming agent is close
# to that line. Read https://agentrouter.org/docs/terms.html before wiring the
# cron jobs to it, or the key gets suspended and the whole system stops.

# ---------------------------------------------------------------------------
# PER-WORKER MODELS (optional)
# ---------------------------------------------------------------------------
# Each profile pins its own model so a cheap model runs the daily check-in and
# a strong one runs the analysis. Unset values fall back to Hermes' default.
# Format is always "<provider>/<model>".
# Layer 1 — decides what everyone else does. Use the strongest model here.
HAA_ORCHESTRATOR_MODEL=anthropic/claude-sonnet-4.5
# Layer 2 — owns one project's rules end to end.
HAA_LEAD_MODEL=anthropic/claude-sonnet-4.5
# Layer 3 — the workers.
HAA_ANALYZER_MODEL=anthropic/claude-sonnet-4.5
HAA_DAILY_MODEL=anthropic/claude-haiku-4.5
HAA_QUESTS_MODEL=anthropic/claude-sonnet-4.5
HAA_DISCORD_MODEL=anthropic/claude-sonnet-4.5
HAA_MONITOR_MODEL=anthropic/claude-sonnet-4.5
HAA_CRON_MODEL=anthropic/claude-haiku-4.5

# ---------------------------------------------------------------------------
# BROWSER — Chrome via CDP, running on this machine
# ---------------------------------------------------------------------------
# Airdrop work is ~100% GUI: connect wallet, click claim, approve, sign, read a
# quest board. There is no CLI for any of it, so the browser is the product.
#
# Chrome runs on the HOST with a real visible window. No Docker, no VNC, no
# --no-sandbox. Launch it with ./scripts/start-browser.sh.
#
# Precedence (from Hermes' tools/browser_cdp_tool.py):
#   1. BROWSER_CDP_URL   <- this file (live override)
#   2. browser.cdp_url   <- config/hermes/**/config.yaml
BROWSER_CDP_URL=http://127.0.0.1:9222

# Port Chrome listens on for remote debugging.
HAA_CDP_PORT=9222

# Chrome profile directory. MUST NOT be your default Chrome profile:
# Chrome 136+ silently refuses to open the debug port when
# --remote-debugging-port is combined with the default user-data-dir. The
# browser launches, nothing listens, and there is no error message.
HAA_CHROME_PROFILE=

# ---------------------------------------------------------------------------
# TELEGRAM — both the UI and the alert channel. ONE bot serves both.
# ---------------------------------------------------------------------------
# Create the bot with @BotFather. Get your numeric user/chat id from
# @userinfobot.
#
# Two different subsystems read these, and the distinction matters:
#
#   Hermes gateway  ->  TELEGRAM_BOT_TOKEN, TELEGRAM_ALLOWED_USERS,
#                       TELEGRAM_HOME_CHANNEL
#                       This is the UI: you message the bot, the orchestrator
#                       answers.
#
#   haa notify      ->  TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
#                       This is the pager: halts and failures get pushed to
#                       you. Without TELEGRAM_CHAT_ID they are only written to
#                       data/logs/ and nobody is told.
#
# TELEGRAM_ALLOWED_USERS is a whitelist. Without it, anyone who finds the bot
# can drive a browser that is logged into your accounts. Always set it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_CHAT_ID=
TELEGRAM_HOME_CHANNEL=

# ---------------------------------------------------------------------------
# WHERE THINGS LIVE (used by config.yaml via ${...})
# ---------------------------------------------------------------------------
# install.sh sets these for you. Absolute paths only.
HAA_PROJECT_DIR=
HAA_DATA_DIR=

# ---------------------------------------------------------------------------
# SPEND GUARDRAILS
# ---------------------------------------------------------------------------
# Per-action ceiling in USD. `haa plan` and the guardrails refuse anything
# above this without an explicit decision from you.
HAA_MAX_SPEND_USD=5.00

# ---------------------------------------------------------------------------
# WALLET ADDRESSES — monitoring only
# ---------------------------------------------------------------------------
# ADDRESSES ONLY. Never put a private key, seed phrase, or keystore here.
# `haa doctor` refuses to start if it finds key material in this file, and the
# evidence ledger refuses to log it. Keys belong in a hardware wallet.
#
# Prefer `haa wallets add --address 0x... --tier farming` — it validates the
# format, detects the chain, and writes data/wallets.json with mode 0600.
WALLET_ADDRESS_MAIN=
WALLET_ADDRESS_FARMING1=
WALLET_ADDRESS_FARMING2=

# ---------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# ---------------------------------------------------------------------------
NOTION_API_KEY=
NOTION_DATABASE_ID=
